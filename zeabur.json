{
  "$schema": "https://schema.zeabur.com/template.json",
  "name": "AgentPaper",
  "description": "AI-powered Academic Research Assistant",
  "services": [
    {
      "name": "python-server",
      "type": "prebuilt",
      "source": {
        "type": "dockerfile",
        "path": "Dockerfile.python"
      },
      "env": {
        "LLM_PROVIDER": "deepseek",
        "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}",
        "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
        "ALLOWED_ORIGINS": "*"
      }
    },
    {
      "name": "frontend",
      "type": "prebuilt",
      "source": {
        "type": "dockerfile",
        "path": "Dockerfile.frontend"
      },
      "dependsOn": ["python-server"]
    }
  ]
}
